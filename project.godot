; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="西行·玄奘 3D"
config/description="塔克拉玛干第一人称：氛围优先，走、沙暴、体力、幻影。"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Controls="*res://scripts/autoload/controls.gd"
GameState="*res://scripts/autoload/game_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[editor]

movie_writer/movie_file="E:/godot_movies/111.avi"

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.72, 0.53, 0.32, 1)
anti_aliasing/quality/screen_space_aa=1
